AURA_GRADE_API_URL=http://localhost:3000
AURA_GRADE_BFF_SECRET=replace-with-the-same-32-character-backend-secret
SESSION_COOKIE_NAME=ag_session
# Cantidad de proxies confiables delante de Next.js. El proxy de borde debe
# sobrescribir o anexar X-Forwarded-For y bloquear el acceso directo al proceso.
AURA_GRADE_TRUSTED_PROXY_HOPS=1

# Una sola configuración de ejecución para navegador, servidor y Edge. El DSN
# público puede exponerse; nunca uses NEXT_PUBLIC_ para el token de subida.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Solo durante la compilación CI para subir source maps.
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN se configura como secreto del proveedor de CI, no aquí.
